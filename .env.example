# Northway Plans: copy to .env for local development (.env is git-ignored).
# Both values are PUBLIC by design (see SUPABASE_SETUP.md section 5).
# Never put a Supabase secret / service_role key, JWT secret or database password here.
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>

# Leave these unset (upstream OpenPlan3D features that send data elsewhere):
# PUBLIC_ENABLE_ANALYTICS=
# HANDOFF_UPLOADS_ENABLED=
# ASSISTANT_SHARES_ENABLED=
